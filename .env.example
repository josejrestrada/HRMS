# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Add the same names in Vercel > Project > Settings > Environment Variables.

# Neon Postgres (server-side only; pooled connection string for the application role)
DATABASE_URL=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Email (Resend)
RESEND_API_KEY=

# HR assistant agent (use one provider)
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional: which one to use (gemini or groq) and a model name. Defaults are chosen from the key you set.
AGENT_PROVIDER=
AGENT_MODEL=

# Protects the scheduled-job endpoints
CRON_SECRET=

# Encryption key for PAN, bank and salary fields. Keep separate from database credentials.
PII_ENCRYPTION_KEY=

# Local seed only (npm run db:seed): the email you sign in with, to be made the test HR admin.
HR_ADMIN_EMAIL=

# Database tests (npm run test:db) run only against a database you name on purpose: the HOST of your
# DEVELOPMENT database, copied from DATABASE_URL. Never put a production host here.
TEST_DATABASE_HOST=
