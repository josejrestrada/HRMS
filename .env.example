# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Add the same names in Vercel > Project > Settings > Environment Variables.

# Supabase (server-side only; there is no public Supabase key in this app)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Email (Resend)
RESEND_API_KEY=

# HR assistant agent (use one provider)
GEMINI_API_KEY=
GROQ_API_KEY=

# Protects the scheduled-job endpoints
CRON_SECRET=

# Encryption key for PAN, bank and salary fields. Keep separate from database credentials.
PII_ENCRYPTION_KEY=
